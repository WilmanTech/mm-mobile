# Podfile for mm-mobile (KMP shared module + iOS app)
#
# This Podfile is consumed by `pod install` from the ios/ directory.
# It references the shared KMP framework as a development pod sourced
# from the :shared Gradle module via `podGen`/`podInstall` tasks.

platform :ios, '17.0'
use_frameworks!
inhibit_all_warnings!

target 'MusicManager' do
  # The shared KMP module is integrated via the cocoapods plugin
  # (kotlin-multiplatform). `pod 'shared', :path => '../shared'` makes
  # CocoaPods read the auto-generated `shared/shared.podspec` and build
  # the KMP framework on-demand via the `Build shared` script phase.
  pod 'shared', :path => '../shared'

  post_install do |installer|
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
        config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
        config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
        # Suppress Cinterop "duplicate conformance" warnings when the
        # same module is re-exported across kotlin targets.
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      end
    end
  end
end
